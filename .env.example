# ===== 模型 API（必读）=====
# 不填任何模型 Key 时：系统不会发起请求，自动回退规则与本地演示数据。
# DeepSeek 示例：
# OPENAI_API_KEY=你的DeepSeekKey
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ===== 高德 Web服务 Key（可选，但真实酒店/餐厅/图片需要）=====
AMAP_API_KEY=

# 百度地图 AK（可选）
BAIDU_AK=
